{
	"name": "simply-tweeted-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev --persist-to ../../.wrangler-state",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250510.0",
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.1.7",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.7",
		"typescript": "^5.0.0",
		"vite": "^6.2.6",
		"wrangler": "^4.16.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@auth/sveltekit": "^1.9.2",
		"daisyui": "^5.0.35",
		"date-fns-tz": "^3.2.0",
		"emoji-picker-element": "^1.26.3",
		"shared-lib": "file:../shared-lib"
	}
}
