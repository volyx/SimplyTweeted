{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simplytweeted-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-05-01",
	// nodejs_compat covers both node:crypto (shared-lib token encryption) and the
	// AsyncLocalStorage that backs SvelteKit's $env/dynamic/private on Workers.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Custom domain. The volyx.in zone must be on this Cloudflare account; wrangler
	// creates the DNS record and edge certificate on first deploy.
	"routes": [
		{
			"pattern": "twitter.volyx.in",
			"custom_domain": true
		}
	],
	// Same database_id as packages/scheduler/wrangler.jsonc — one D1, two bindings.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simplytweeted",
			"database_id": "109e7fcc-c198-47cf-a976-a87d15c40697",
			// Resolved relative to THIS config file, not cwd. The repo root has no
			// wrangler config, so the root package.json migration scripts target
			// this one with --config.
			"migrations_dir": "../../migrations"
		}
	],
	// Workers AI, for the composer's "Split with AI" button. Inference runs on
	// Cloudflare's GPUs — no API key, and the request never leaves the platform.
	// `remote: true` points local `wrangler dev` at real inference, because there
	// are no models in the local runtime.
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"observability": {
		"enabled": true
	}
	// Secrets (wrangler secret put): AUTH_SECRET, DB_ENCRYPTION_KEY,
	// AUTH_TWITTER_ID, AUTH_TWITTER_SECRET, ALLOWED_TWITTER_ACCOUNTS
}
